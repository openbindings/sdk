+//! Property-name syntax from ECMA-262 11th edition, Tables 56–58.
+//! Generated from https://262.ecma-international.org/11.0/ . This lists names,
+//! not Unicode character membership; the SDK declines property matching.
+use crate::unicode::UnicodePropertyName;
+pub(crate) fn valid(value: &str, name: Option<UnicodePropertyName>) -> bool {
+    match name {
+        Some(UnicodePropertyName::GeneralCategory) => CATEGORY.binary_search(&value).is_ok(),
+        Some(UnicodePropertyName::Script) | Some(UnicodePropertyName::ScriptExtensions) => {
+            SCRIPT.binary_search(&value).is_ok()
+        }
+        None => BINARY.binary_search(&value).is_ok() || CATEGORY.binary_search(&value).is_ok(),
+    }
+}
