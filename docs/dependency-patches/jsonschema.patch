+
+[[bench]]
+harness = false
+name = "unevaluated_items"
+
+[[bench]]
+harness = false
+name = "metaschema"
+required-features = ["macros"]
+
+[[bench]]
+harness = false
+name = "canonicalize"
+required-features = ["macros"]
+
+[[bench]]
+harness = false
+name = "canonicalize_many"
+required-features = ["macros"]
+
+[[bench]]
+harness = false
+name = "jsonb"
+required-features = ["jsonb"]
