  "groups": [
    {
      "id": "NI-01",
      "name": "Exact admitted numeric tokens",
      "require": "Every frozen token matches the independent mathematical integer answer and the old number(...).is_integer result; preserve all charges even when fallback Decimal ultimately fits inline."
    },
    {
      "id": "NI-02",
      "name": "Public kind and type-name boundaries",
      "cases": [
        {
          "schema": {
            "type": "integer"
          },
          "value": null,
          "expected": "F"
        },
        {
          "schema": {
            "type": "integer"
          },
          "value": false,
          "expected": "F"
        },
        {
          "schema": {
            "type": "integer"
          },
          "value": true,
          "expected": "F"
        },
        {
          "schema": {
            "type": "integer"
          },
          "value": "1",
          "expected": "F"
        },
        {
          "schema": {
            "type": "integer"
          },
          "value": [],
          "expected": "F"
        },
        {
          "schema": {
            "type": "integer"
          },
          "value": {},
          "expected": "F"
        },
        {
          "schema": {
            "type": [
              "integer",
              "string"
            ]
          },
          "value": "x",
          "expected": "S"
        },
        {
          "schema": {
            "type": [
              "string",
              "integer"
            ]
          },
          "value": 1,
          "expected": "S"
        }
      ],
      "require": "No numeric parser/work charge for a non-Number branch. Invalid type shape/name remains its current admission/local-inability policy; test null, number, unknown string, nested array and unpaired type name under permissive custom meta. Empty type array remains F."
    },
    {
      "id": "NI-03",
      "name": "Eager type-union visit preservation",
      "cases": [
        {
          "schema": {
            "type": [
              "integer",
              17
            ]
          },
          "value": 1,
          "expected_local": "N:UnsupportedCapability"
        },
        {
          "schema": {
            "type": [
              17,
              "integer"
            ]
          },
          "value": 1,
          "expected_local": "N:UnsupportedCapability"
        }
      ],
      "require": "Under a permissive custom meta, successful integer does not short-circuit later invalid names. Standard-meta admission rejection remains a separate unchanged boundary."
    },
    {
      "id": "NI-04",
      "name": "Direct exact work and reservation boundaries",
      "require": "For each token, old and new direct Graph traces exactly agree. Succeed at W, refuse W-1 before parse; for fallback succeed at M and refuse M-1 after the same work/control sequence. i64 accepts zero reservation, but cannot bypass low work or cancellation. Check positive pre-spent work/storage as well as empty ledgers."
    },
    {
      "id": "NI-05",
      "name": "Every actual stop and first cause",
      "require": "Record every observed WorkControl and enclosing Preparation Control boundary. Old/new result and trace must match for cancellation at each; shared prior work/storage/cancel cause remains first. Retry on the same owner/input after interruption matches the uninterrupted full outcome. Do not add a callback during or after Decimal parsing."
    },
    {
      "id": "NI-06",
      "name": "Exact fallback remains unchanged",
      "require": "Fractions and exponents never use a fractional-part approximation or f64. Wide plain integers still take the old parse/charge path; zero with huge signed exponent remains integer. Compare exact F/Undefined/NoVerdict diagnostics when embedded in later failing/limited branches; no branch skipping beyond the existing kind short-circuit."
    },
    {
      "id": "NI-07",
      "name": "Actual allocation and ownership",
      "require": "Small i64 path has no incremental allocations before/after; no retained value, cache, control or source owner added. For wide inputs retain existing Decimal allocations and release; do not weaken the scoped reservation based on an inline fallback sample."
    },
    {
      "id": "NI-08",
      "name": "Integration and performance boundary",
      "require": "Current/minimum Rust, both detail modes and complete original locations; preserved20k/late-invalid array,50k object and700k numeric jobs as appropriate to the parent validation lane. Compare the same frozen selected requests and exact direct trace policy, not only a microbenchmark. Performance acceptance and G6 remain separate."
    },
    {
      "id": "NI-09",
      "name": "Invalid JSON is not an integer-helper API",
      "tokens": [
        "+1",
        "01",
        "1.",
        "NaN",
        "Infinity",
        "--1"
      ],
      "require": "Existing JsonValue parsing rejects these before semantic predicates. The helper consumes validated Number tokens; it must not become a public parser or silently repair syntax."
    }
  ]
}
