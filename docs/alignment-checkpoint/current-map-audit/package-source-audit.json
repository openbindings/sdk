  "additional_private_packages": {
    "openbindings-internal-json": "One version-locked exact JSON arena/parser, decimal arithmetic and work ledger is shared by core and optional companions. Public exact types are re-exported by core; storage/backend mechanics are not independent document concepts.",
    "openbindings-internal-schema": "Shared original schema inventory/profile/URI interpretation and guarded fixed checks avoid separate meanings in core and optional evaluator/comparison. These are private Rust implementation mechanisms. The outgoing projection/compiler portions are still slated for retirement.",
    "openbindings-internal-cancellation": "One cancellation token/future identity and scoped asynchronous relay/run_attempt serve the optional companions. Core only supplies the minimal WorkControl seam; async provider cancellation does not become a core specification concept."
  },
  "boundary_findings": [
    "The11 logical design boundaries correspond to10 product Rust packages plus TypeScript; actual Rust organization additionally contains3 shared private implementation packages. This difference is intentional and must be explicit in the final map.",
    "Default evaluator is a production dependency of the Wasm bridge, but only a dev/example dependency of invocation/test support. Core and role APIs do not import it.",
    "Comparison is a provider/example dependency for source-pull, not a production dependency of the generic relationship checker.",
    "Conditional HTTP native transport, third-party dependencies and dev-only consumers are distinct from the conceptual authority graph.",
    "No legacy inspection/synthesis/internal-interface crate remains.",
    "Evaluator top-level module names still describe a transitional two-engine implementation; final organization must be re-audited after removing outgoing projection/compiler paths."
  ],
  "working_delta": "HTTP companion public authority pin updated after57cdc22; no module/dependency behavior change."
