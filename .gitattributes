# Vendored fork files keep their exact bytes on every host:
# tools/dependency-patches.py compares each with its upstream archive, and
# tools/attribution.py hashes the forks' notice files.
/vendor/** -text
# tools/attribution.py also hashes retrieved notice files and compares the
# generated inventories byte-for-byte, so these keep their exact bytes too.
/tools/attribution/retrieved/** -text
/DEPENDENCIES.json -text
/THIRD-PARTY-NOTICES.txt -text
/packages/typescript/DEPENDENCIES.json -text
/packages/typescript/THIRD-PARTY-NOTICES.txt -text
# tools/verify-fixture-digests.py compares vendored interface fixtures with the
# digests their READMEs record, so they keep their exact bytes on every host too.
/crates/openbindings-interface-synthesis/tests/fixtures/** -text
/crates/openbindings-internal-schema/tests/fixtures/** -text
/crates/openbindings-invocation/tests/fixtures/** -text
/crates/openbindings-source-inspection/tests/fixtures/** -text
