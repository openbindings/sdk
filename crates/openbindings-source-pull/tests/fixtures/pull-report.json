        "bindings": {
          "getUser.api": {
            "operation": "getUser",
            "source": "api",
            "data": {
              "selector": "#/paths/~1users~1{id}/get"
            }
          }
        }
      },
      "report": {
        "exhaustive": true,
        "added": [
          {
            "binding": "getUser.api",
            "operation": "getUser",
            "uses": [
              "schemas/User",
              "schemas/Address"
            ]
          }
        ],
        "existing": [
          {
            "source": "api",
            "status": "current"
          }
        ]
      },
      "schemaValid": true,
      "completePull": true
    },
