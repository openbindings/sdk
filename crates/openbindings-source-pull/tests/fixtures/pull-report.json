        }
      },
      "source": "api",
      "additions": {
        "schemas": {
          "User": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "address": {
                "$ref": "#/schemas/Address"
              }
            }
          },
          "Address": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string"
              }
            }
          }
        },
        "operations": {
          "getUser": {
            "input": {
              "$ref": "#/schemas/UserId"
