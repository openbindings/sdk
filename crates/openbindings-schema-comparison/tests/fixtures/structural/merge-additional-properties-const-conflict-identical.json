  "options": {
    "profile": "OB-2020-12"
  },
  "left": {
    "openbindings": "0.2.0",
    "operations": {
      "test": {
        "input": {
          "type": "object",
          "additionalProperties": {
            "allOf": [
              {
                "const": 1
              },
              {
                "const": 2
              }
            ]
          }
        }
      }
    }
  },
  "right": {
    "openbindings": "0.2.0",
    "operations": {
