{
  "version": "1.0",
  "description": "An empty type intersection in a union variant normalizes that variant to the exact empty schema.",
  "mode": "identical",
  "options": {
    "profile": "OB-2020-12"
  },
  "left": {
    "openbindings": "0.2.0",
    "operations": {
      "test": {
        "input": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "allOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          ]
        }
      }
    }
  },
  "right": {
    "openbindings": "0.2.0",
    "operations": {
      "test": {
        "input": {
          "anyOf": [
            {
              "type": "string"
            },
            false
          ]
        }
      }
    }
  },
  "expected": {
    "summary": {
      "verdict": "compatible"
    }
  }
}
