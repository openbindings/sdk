        "input": {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "a": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "b": {
                  "type": "string"
                }
              }
            }
          ]
        }
      }
    }
  },
  "right": {
    "openbindings": "0.2.0",
    "operations": {
      "submit": {
        "input": {
          "type": "object",
          "properties": {
            "a": {
              "type": "string"
            },
            "b": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "expected": {
    "summary": {
      "verdict": "incompatible"
    }
  }
}
