{
  "root": "B32",
  "document": "document.json",
  "conformance": {
    "expected": "conforms",
    "rationale": {
      "OBI-01": "The text is UTF-8 JSON without BOM or duplicate keys, and large integers are literal decimal tokens.",
      "OBI-02": "Only specified fields and x-routing-note appear at the OBI layer; null source content, string binding content and omitted binding content are permitted.",
      "OBI-03": "0.2.0+queue.b32 is SemVer and has 0.2 line semantics; build metadata adds no core semantics.",
      "OBI-04": "All operation, schema, source, dependency, binding, example and alias names match the whole-name grammar. The working directory property is schema data, not an OBI map name.",
      "OBI-05": "Five primary operation keys and two aliases form a unique identifier namespace.",
      "OBI-06": "All six bindings name existing primary operation keys.",
      "OBI-07": "All bindings refer to queue_events or runner_local.",
      "OBI-08": "Both dependencies reference the primary operation key run_job.",
      "OBI-09": "Only runner_packet declares $schema among contained schemas, and it declares 2020-12 at its own resource root. Content metadata is not a contained schema.",
      "OBI-10": "Each contained schema is a valid 2020-12 object; recursive reference structure does not invalidate schema syntax. The supplied external schema is separate from document conformance.",
      "OBI-11": "Document-resource references are same-document or absolute; runner_packet has an absolute $id. Its internal local references are governed by its own resource.",
      "OBI-12": "#/schemas/build_request and #schedule-state reach OBI-position schemas in the embedding document. References into runner_packet use its absolute resource URI.",
      "OBI-13": "schedule-state is the only document-resource plain name; step belongs only to runner_packet. The single contained $id is unique."
    }
  },
