{
  "cluster": "automatic-resolution",
  "description": "Without `binding` or `selection`, a sole invocable binding is selected and several invocable bindings are refused. Preference, deprecation, key order, and implementation order do not invent a choice.",
  "tests": [
    {
      "description": "a sole invocable binding is selected even when deprecated and negatively preferred",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getThing": {}
        },
        "sources": {
          "rpc": {
            "kind": "example.grpc@1"
          }
        },
        "bindings": {
          "getThing.rpc": {
            "operation": "getThing",
            "source": "rpc",
            "data": {
              "selector": "things.v1.Things/GetThing"
            },
            "preference": -100,
            "deprecated": true
          }
        }
      },
      "operation": "getThing",
      "supported": [
        "example.grpc@1"
      ],
      "expected": {
        "binding": "getThing.rpc"
      }
    },
    {
      "description": "several invocable bindings require a caller choice despite preference and deprecation metadata",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getThing": {}
        },
        "sources": {
          "rest": {
            "kind": "example.openapi@1"
          },
          "rpc": {
            "kind": "example.grpc@1"
          }
        },
        "bindings": {
          "getThing.rest": {
            "operation": "getThing",
            "source": "rest",
            "data": {
              "selector": "#/paths/~1things~1{id}/get"
            },
            "preference": 100
          },
          "getThing.rpc": {
            "operation": "getThing",
            "source": "rpc",
            "data": {
              "selector": "things.v1.Things/GetThing"
            },
            "preference": 1,
            "deprecated": true
          }
        }
      },
      "operation": "getThing",
      "supported": [
        "example.openapi@1",
        "example.grpc@1"
      ],
      "expected": {
        "error": true,
        "kind": "ambiguous"
      }
    },
    {
      "description": "binding-key lexical order never resolves ambiguity",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getThing": {}
        },
        "sources": {
          "z": {
            "kind": "example.openapi@1"
          },
          "a": {
            "kind": "example.openapi@1"
          }
        },
        "bindings": {
          "getThing.z": {
            "operation": "getThing",
            "source": "z",
            "data": {
              "selector": "#/paths/~1z/get"
            }
          },
          "getThing.a": {
            "operation": "getThing",
            "source": "a",
            "data": {
              "selector": "#/paths/~1a/get"
            }
          }
        }
      },
      "operation": "getThing",
      "supported": [
        "example.openapi@1"
      ],
      "expected": {
        "error": true,
        "kind": "ambiguous"
      }
    }
  ]
}
