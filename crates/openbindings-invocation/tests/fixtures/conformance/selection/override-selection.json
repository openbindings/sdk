        "openbindings.openapi-3.1@1",
        "openbindings.grpc@1"
      ],
      "selection": [
        "getThing.nope",
        "getThing.rpc"
      ],
      "expected": {
        "error": true,
        "kind": "unknown-binding"
      }
    },
