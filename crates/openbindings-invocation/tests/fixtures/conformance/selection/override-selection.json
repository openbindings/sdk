{
  "cluster": "override-selection",
  "description": "Caller choice: `selection` is an ordered list of binding keys, the first invocable entry winning. Every listed key must name a binding of the resolved operation; a key that does not is ERR_BINDING_NOT_FOUND. Entries whose source's kind the invoker cannot act on are passed over. When no listed entry is invocable, the list fails with ERR_BINDING_NOT_FOUND and never falls back to an unlisted binding.",
  "tests": [
    {
      "description": "the override displaces the default policy: a listed key wins over the policy's preferred candidate",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getThing": {}
        },
        "sources": {
          "rest": {
            "kind": "openbindings.openapi-3.1@1",
            "content": {
              "location": "https://example.com/things/openapi.json"
            }
          },
          "rpc": {
            "kind": "openbindings.grpc@1",
            "content": {
              "location": "https://example.com/things/things.protoset"
            }
          }
        },
        "bindings": {
          "getThing.rest": {
            "operation": "getThing",
            "source": "rest",
            "content": {
              "selector": "#/paths/~1things~1{id}/get"
            },
            "preference": 100
          },
          "getThing.rpc": {
            "operation": "getThing",
            "source": "rpc",
            "content": {
              "selector": "things.v1.Things/GetThing"
            },
            "preference": 1
          }
        }
      },
      "operation": "getThing",
      "supported": [
        "openbindings.openapi-3.1@1",
        "openbindings.grpc@1"
      ],
      "selection": [
        "getThing.rpc"
      ],
      "expected": {
        "binding": "getThing.rpc"
      }
    },
    {
      "description": "list order decides between two invocable entries: the first wins",
      "document": {
