        },
        "bindings": {
          "getThing.rest": {
            "operation": "getThing",
            "source": "rest",
            "content": {
              "selector": "#/paths/~1things~1{id}/get"
            },
            "preference": 1
          },
          "getThing.rpc": {
            "operation": "getThing",
            "source": "rpc",
            "content": {
              "selector": "things.v1.Things/GetThing"
            },
            "preference": 100
          }
        }
      },
      "operation": "getThing",
      "supported": [
        "openbindings.openapi-3.1@1",
        "openbindings.grpc@1"
      ],
      "selection": [
        "getThing.rest",
        "getThing.rpc"
      ],
      "expected": {
        "binding": "getThing.rest"
      }
    },
    {
      "description": "a listed key that names no binding is an error, even when a later entry is invocable",
