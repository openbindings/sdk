{
  "cluster": "explicit-binding",
  "description": "When the caller names a `binding`, that binding is used and other resolution is bypassed: ambiguity does not change it, and deprecation does not disqualify the named binding. An undefined binding key is ERR_BINDING_NOT_FOUND.",
  "notes": "On the wire, OperationInvocationInput carries `operation` and `binding` mutually exclusively (the operation is derived from an explicit binding); each fixture carries the derived operation key alongside so operation-keyed native APIs can drive the same scenario. Whether the invoker can act on the kind of the bypassed binding's source is an invocation concern, not a selection concern, so no fixture pins the bypass-to-unsupported-kind outcome.",
  "tests": [
    {
      "description": "an explicit binding key resolves a choice that would otherwise be ambiguous",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getThing": {}
        },
        "sources": {
          "rest": {
            "kind": "example.openapi@1"
          },
          "rpc": {
            "kind": "example.grpc@1"
          }
        },
        "bindings": {
          "getThing.rest": {
            "operation": "getThing",
            "source": "rest",
            "data": {
              "selector": "#/paths/~1things~1{id}/get"
            },
            "preference": 100
          },
          "getThing.rpc": {
            "operation": "getThing",
            "source": "rpc",
            "data": {
              "selector": "things.v1.Things/GetThing"
            },
            "preference": 1
          }
        }
      },
      "operation": "getThing",
      "supported": [
        "example.openapi@1",
        "example.grpc@1"
      ],
      "binding": "getThing.rpc",
      "expected": {
        "binding": "getThing.rpc"
      }
    },
    {
      "description": "an explicit binding key selects a deprecated binding: deprecation never disqualifies an explicit choice",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getThing": {}
        },
        "sources": {
          "rest": {
            "kind": "example.openapi@1"
          },
          "rpc": {
            "kind": "example.grpc@1"
          }
        },
        "bindings": {
          "getThing.rest": {
            "operation": "getThing",
            "source": "rest",
            "data": {
              "selector": "#/paths/~1things~1{id}/get"
            }
          },
          "getThing.rpc": {
            "operation": "getThing",
            "source": "rpc",
            "data": {
              "selector": "things.v1.Things/GetThing"
            },
            "deprecated": true
          }
        }
      },
      "operation": "getThing",
      "supported": [
        "example.openapi@1",
        "example.grpc@1"
      ],
      "binding": "getThing.rpc",
      "expected": {
        "binding": "getThing.rpc"
      }
    },
    {
      "description": "an explicit binding key that is not defined on the interface is an error",
      "document": {
        "openbindings": "0.2.0",
        "operations": {
          "getThing": {}
        },
        "sources": {
          "rest": {
            "kind": "example.openapi@1"
          }
        },
        "bindings": {
          "getThing.rest": {
            "operation": "getThing",
            "source": "rest",
            "data": {
              "selector": "#/paths/~1things~1{id}/get"
            }
          }
        }
      },
      "operation": "getThing",
      "supported": [
        "example.openapi@1"
      ],
      "binding": "getThing.nope",
      "expected": {
        "error": true,
        "kind": "unknown-binding"
      }
    }
  ]
}
